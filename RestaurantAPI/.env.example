# Configure these in Render's environment settings; Spring does not read this file itself.
SPRING_PROFILES_ACTIVE=production
DATABASE_URL=jdbc:postgresql://HOST:5432/DATABASE
DATABASE_USERNAME=REPLACE_ME
DATABASE_PASSWORD=REPLACE_ME
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
ORDER_EMAIL=REPLACE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
CUSTOMER_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
